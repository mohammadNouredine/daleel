{
  "moduleFileExtensions": ["js", "json", "ts", "mjs"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest",
    "^.+\\.mjs$": "ts-jest"
  },
  "transformIgnorePatterns": [
    "/node_modules/(?!(@thallesp/nestjs-better-auth|better-auth|better-call|@better-auth|nanostores|jose|@noble|rou3|defu|uncrypto)/)"
  ]
}
