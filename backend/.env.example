NODE_ENV=development
PORT=8001
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/daleel?retryWrites=true&w=majority

# Better Auth (generate secret: openssl rand -base64 32)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3001
TRUSTED_ORIGINS=http://localhost:3000,http://localhost:8000

# Startup admin (created once on first boot if missing)
ADMIN_EMAIL=admin@daleel.local
ADMIN_PASSWORD=change-me-in-production
ADMIN_FULL_NAME=Daleel Admin

# Storage provider: cloudinary (default)
STORAGE_PROVIDER=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER_PREFIX=daleel
